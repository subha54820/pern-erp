# PostgreSQL Connection
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_NAME=pern_erp

# Server
PORT=5000

# JWT Secret
JWT_SECRET=your_super_secret_jwt_key_change_in_production

# Set to 'true' to use in-memory PostgreSQL (pg-mem) instead of real PostgreSQL
# Useful when PostgreSQL is not installed or for quick demo
USE_PG_MEM=false
